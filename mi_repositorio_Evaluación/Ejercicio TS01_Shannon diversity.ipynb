   "source": [
    "import pandas as pd\n",
    "\n",
    "def read_csv_to_dataframe(file_path: str) -> pd.DataFrame:\n",
    "    try:\n",
    "        df = pd.read_csv(file_path)\n",
    "        return df\n",
    "    except Exception as e:\n",
    "        print(f\"Error reading CSV file: {e}\")\n",
    "        return pd.DataFrame()"
   ]
